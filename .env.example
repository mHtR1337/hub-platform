# Copy to .env.local and fill in real values. Never commit .env.local.

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk routing — must match your actual page paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# Stripe — https://dashboard.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create products in Stripe dashboard first)
STRIPE_PRICE_HRV_MONITOR=price_...
STRIPE_PRICE_COMBAT_TRACKER=price_...
STRIPE_PRICE_ENDURANCE_CALC=price_...
STRIPE_PRICE_BUNDLE=price_...

# Database — Supabase Postgres
# Get both from: Supabase Dashboard → Project Settings → Database → Connection string
#
# Pooled (pgBouncer, port 6543) — used by the Next.js app at runtime.
# IMPORTANT: URL-encode special characters in the password ($ → %24, & → %26, @ → %40).
# Append ?pgbouncer=true&connection_limit=1 to avoid connection pool exhaustion in serverless.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# Direct (port 5432) — used ONLY by Prisma CLI for migrations. Never used at runtime.
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_...

# Internal bootstrap (used only for seeding admin user, never exposed to client)
ADMIN_SECRET=change-me-before-production
