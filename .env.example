# Copy to .env.local and fill in real values. Never commit .env.local.

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Stripe — https://dashboard.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create products in Stripe dashboard first)
STRIPE_PRICE_HRV_MONITOR=price_...
STRIPE_PRICE_COMBAT_TRACKER=price_...
STRIPE_PRICE_ENDURANCE_CALC=price_...
STRIPE_PRICE_BUNDLE=price_...

# Database (Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/hub_dev

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_...

# Internal bootstrap (used only for seeding admin user, never exposed to client)
ADMIN_SECRET=change-me-before-production
