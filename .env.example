# =============================================================================
# Hub Platform — environment variables
# =============================================================================
# Copy to .env.local for local development. Never commit .env.local.
#
# Three environments (see docs/ENVIRONMENTS.md):
#   dev   — localhost, Supabase dev project, Clerk dev, Stripe test
#   test  — Vercel staging, Supabase staging, Clerk dev, Stripe test
#   prod  — Azure Container Apps / AWS ECS, managed Postgres, Clerk prod, Stripe live
# =============================================================================

# -----------------------------------------------------------------------------
# Environment identity
# -----------------------------------------------------------------------------
# dev | test | prod — exposed to the client for UI/feature toggles
NEXT_PUBLIC_APP_ENV=dev

# Public base URL (no trailing slash)
# dev:  http://localhost:3000
# test: https://hub-platform-staging.vercel.app  (or your Vercel preview URL)
# prod: https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# dev/test: Supabase pooler URLs (Connect → Prisma in Supabase Dashboard)
# prod:     Azure Database for PostgreSQL or AWS RDS connection string
#
# DATABASE_URL — pooled (port 6543 on Supabase) for app runtime
# DIRECT_URL   — session/direct (port 5432) for Prisma migrations only
#
# PASSWORD RULE: use only alphanumeric characters (a-z, A-Z, 0-9).
# Special characters ($, &, #, @, etc.) break connection URLs and cause
# ENOTFOUND / auth errors. Reset at Supabase Dashboard → Settings → Database
# → Reset database password if your password contains special characters.
#
# Supabase example (replace [ref], [region], [password]):
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
#
# Managed Postgres (prod) example:
# DATABASE_URL=postgresql://hubapp:[password]@hub-db.postgres.database.azure.com:5432/hub?sslmode=require
# DIRECT_URL=postgresql://hubapp:[password]@hub-db.postgres.database.azure.com:5432/hub?sslmode=require

# -----------------------------------------------------------------------------
# Clerk authentication
# -----------------------------------------------------------------------------
# dev/test: Clerk *development* instance (pk_test_ / sk_test_)
# prod:     Clerk *production* instance (pk_live_ / sk_live_)
# https://dashboard.clerk.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Routing — must match app routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# Active provider: stripe (future: paddle, lemon_squeezy — stubbed, not wired yet)
PAYMENT_PROVIDER=stripe

# Stripe — https://dashboard.stripe.com
# dev/test: test mode keys (pk_test_ / sk_test_)
# prod:     live mode keys (pk_live_ / sk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create products in Stripe dashboard, then seed)
STRIPE_PRICE_HRV_MONITOR=price_...
STRIPE_PRICE_COMBAT_TRACKER=price_...
STRIPE_PRICE_ENDURANCE_CALC=price_...
STRIPE_PRICE_BUNDLE=price_...

# Future providers (stubbed — leave empty until implemented)
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email (Resend — https://resend.com)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...

# -----------------------------------------------------------------------------
# Observability (prod only)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://...@sentry.io/...

# -----------------------------------------------------------------------------
# Internal / bootstrap (never expose to client)
# -----------------------------------------------------------------------------
# Used only for seeding admin user during db:seed
ADMIN_SECRET=change-me-before-production
